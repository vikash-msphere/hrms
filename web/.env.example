# Build-time configuration for the SPA. Copy to web/.env and fill in.
#
# These are baked into the JavaScript bundle by Vite at BUILD time, so they are public - never put a secret
# here. A value that is missing at build time cannot be supplied later by a Worker secret; it needs a new
# build. `npm run preflight` reports the ones whose absence silently disables a feature.

# Product name. Shows in the browser tab, the PWA manifest and the install prompt. Default: Meridian.
VITE_APP_NAME=HRMS

# VAPID public key (base64url, P-256) for browser push notifications. Must be the public half of the
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY pair set as Worker secrets (`npx web-push generate-vapid-keys`).
# Leave unset to ship without push: the UI then reports push as unsupported rather than failing.
# VITE_VAPID_PUBLIC_KEY=

# Trust the eSign SANDBOX certificate roots (eMudhra/CCA test hierarchy) in addition to the production ones.
# Development and sandbox builds only. A production build must never set this - preflight fails if it does.
# VITE_ESIGN_ALLOW_SANDBOX=true
