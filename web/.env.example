# Build-time configuration for the SPA. Copy to web/.env and fill in.
#
# These are baked into the JavaScript bundle by Vite at BUILD time, so they are public - never put a secret
# here. A value that is missing at build time cannot be supplied later by a Worker secret; it needs a new
# build. `npm run preflight` reports the ones whose absence silently disables a feature.

# Product name. Shows in the browser tab, the PWA manifest and the install prompt. Default: Meridian.
VITE_APP_NAME=HRMS

# VAPID public key (base64url, P-256) for browser push notifications. Must be the public half of the
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY pair set as Worker secrets (`npx web-push generate-vapid-keys`).
# Leave unset to ship without push: the UI then reports push as unsupported rather than failing.
# VITE_VAPID_PUBLIC_KEY=

# Sentry DSN for the SPA (Sentry -> Settings -> Projects -> <project> -> Client Keys). A DSN is public by
# design - it only permits writing events - so it is safe to bake into the bundle. Leave unset to ship without
# error reporting: instrument.ts then skips Sentry.init entirely, so the SDK costs nothing at runtime.
# The DSN's ingest host must also be allowed by connect-src in web/public/_headers.
# VITE_SENTRY_DSN=

# Sentry organisation slug (the first label of your Sentry URL: https://<slug>.sentry.io). Only used to turn a
# session-replay id stored on a ticket into a link support can click. Without it the ticket shows the bare id
# and someone has to paste it into Sentry by hand - everything else works unchanged.
# VITE_SENTRY_ORG=

# Version string Sentry tags every event with (the `release`). Without it issues arrive as "unknown release"
# and nothing that keys on releases - regression detection, "resolved in next release", per-deploy issue
# counts - can work. Set it in CI to the commit SHA: VITE_APP_VERSION=$(git rev-parse --short HEAD).
# VITE_APP_VERSION=

# Trust the eSign SANDBOX certificate roots (eMudhra/CCA test hierarchy) in addition to the production ones.
# Development and sandbox builds only. A production build must never set this - preflight fails if it does.
# VITE_ESIGN_ALLOW_SANDBOX=true
