# Worker configuration for the browser-test stack, read by BOTH sides so they cannot drift:
# scripts/e2eStack.sh turns each line into a `wrangler dev --var` override, and e2e/fixtures.ts reads
# AUTH_SESSION_KEY from here to sign the session cookies the tests log in with.
#
# These are test-only stand-ins, exactly like the bindings in vitest.config.ts - safe to commit because none
# of them is a secret anywhere. Real values are Worker secrets (`wrangler secret put`) and live in `.dev.vars`
# locally.
#
# A var NOT listed here falls through to `.dev.vars`, which is how a live vendor key reaches this stack, so
# every var naming an outbound provider has to be overridden here whether the tests exercise it or not. That
# is not hypothetical: without the EMAIL_* block below the suite sent real messages through whatever provider
# `.dev.vars` names, to whatever address a spec had just invented.

# Google sign-in mode. Setting GOOGLE_CLIENT_ID is what makes the Worker authenticate from the signed
# `hrms_session` cookie (src/middleware/auth.ts) instead of the dev bypass - which is the whole point, since
# the bypass would resolve every request to one identity. The secret is required alongside it (src/deps.ts)
# but is never exercised: the tests mint their own cookies rather than completing an OAuth round trip.
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret

# All-zero 32-byte key: valid shape for the HMAC + the length assertion, worthless as a secret.
AUTH_SESSION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# In Google mode this is the org perimeter and must list at least one domain (src/deps.ts). The seeded role
# logins are @example.com, so that is the domain here.
ALLOWED_EMAIL_DOMAINS=example.com

# The dev bypass takes BOTH DEV_FAKE_EMAIL and ALLOW_DEV_AUTH=true. Your `.dev.vars` sets both for the dev
# stack, so this override is what switches it off for the test run.
ALLOW_DEV_AUTH=false

# Email goes to the log, not to a vendor (src/lib/email.ts). The specs that walk an emailing path - the
# interview invite, the announcement blast, the workflow email/emailAudience actions - still run the whole
# path down to the sender and still count what it sent; the bytes just never leave the Worker. The key and
# sender are required to be non-empty (src/deps.ts) and are otherwise unread by this provider.
EMAIL_PROVIDER=console
EMAIL_API_KEY=e2e-unused-by-the-console-provider
EMAIL_FROM=e2e@example.com

# The /diag relay's one permitted destination (src/routes/diag.ts). Set so the browser lane exercises the real
# relay path rather than a 404: the spec intercepts /diag in the page, so nothing is ever forwarded upstream.
SENTRY_DSN=https://b0783df050ada7c6adc0a89aaa15b4f4@o4511976927461376.ingest.de.sentry.io/4511982864498768

# The attendance network fence (src/services/attendance.ts) keys on `cf-connecting-ip`, which a browser cannot
# choose - so a fence configured in wrangler.toml refuses EVERY punch in this lane, `clock` included. Empty
# means no fence, which is the deployment shape these specs describe; `clockFence` stubs the refusal in the
# page instead, precisely because it cannot be provoked here.
ATTENDANCE_ALLOWED_IPS=
