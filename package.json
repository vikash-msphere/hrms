{
  "name": "hrms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:proxy": "prism proxy openapi.yaml http://localhost:8787 --errors -p 4010",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:web",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate && tsx scripts/genSearchDdl.ts",
    "db:migrate:local": "wrangler d1 migrations apply hrms --local",
    "db:migrate:remote": "wrangler d1 migrations apply hrms --remote",
    "api:lint": "spectral lint openapi.yaml --fail-severity=warn",
    "api:types": "openapi-typescript openapi.yaml -o src/http/openapi.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run api:lint && npm run typecheck && npm run test",
    "precommit": "npm run verify",
    "prepare": "husky"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@hono/zod-validator": "^0.4",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "asn1js": "^3.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36",
    "hono": "^4",
    "jose": "^5",
    "lucide-react": "^1.17.0",
    "pdf-lib": "^1.17",
    "pdfjs-dist": "^6.1.200",
    "pkijs": "^3.4.0",
    "pvutils": "^1.1.5",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@aep_dev/aep-openapi-linter": "^0.5",
    "@cloudflare/vitest-pool-workers": "^0.5",
    "@cloudflare/workers-types": "^4",
    "@stoplight/spectral-cli": "^6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.28",
    "husky": "^9",
    "openapi-typescript": "^7",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^2",
    "wrangler": "^4"
  }
}
