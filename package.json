{
  "name": "hrms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:proxy": "prism proxy openapi.yaml http://localhost:8787 --errors -p 4010",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:web",
    "preflight": "node --import ./scripts/tsResolve.mjs scripts/preflight.ts",
    "deploy": "npm run preflight && npm run verify && npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate && node --import ./scripts/tsResolve.mjs scripts/genSearchDdl.ts && node --import ./scripts/tsResolve.mjs scripts/genChangeDdl.ts",
    "db:migrate:local": "wrangler d1 migrations apply hrms --local",
    "db:migrate:remote": "wrangler d1 migrations apply hrms --remote",
    "api:lint": "spectral lint openapi.yaml --fail-severity=warn",
    "api:types": "openapi-typescript openapi.yaml -o src/http/openapi.d.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run api:types && tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:ai": "AI_LOCAL_TEST=1 vitest run test/aiLocalIntegration.test.ts",
    "test:gate": "node scripts/testGate.mjs",
    "cleanup:workerd": "scripts/cleanupWorkerd.sh",
    "posttest": "scripts/cleanupWorkerd.sh",
    "posttest:ai": "scripts/cleanupWorkerd.sh",
    "posttest:gate": "scripts/cleanupWorkerd.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:stack": "scripts/e2eStack.sh",
    "verify": "npm run api:lint && npm run lint && npm run typecheck && npm run test:gate",
    "precommit": "npm run verify",
    "prepare": "husky"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@emoji-mart/data": "^1.2.1",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hono/zod-validator": "^0.4",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/cloudflare": "^10.72.0",
    "@sentry/react": "^10.71.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@zxing/library": "^0.23.0",
    "asn1js": "^3.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "frappe-charts": "^1.6.2",
    "hono": "^4.13.7",
    "html-to-image": "^1.11.13",
    "jose": "^5",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.17.0",
    "pdf-lib": "^1.17",
    "pdfjs-dist": "^6.2.108",
    "pkijs": "^3.4.0",
    "pvutils": "^1.1.5",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@aep_dev/aep-openapi-linter": "^0.5.3",
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stoplight/spectral-cli": "^6",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.28",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9",
    "openapi-typescript": "^7",
    "postcss": "^8.5.15",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.0"
  },
  "overrides": {
    "browserslist": "^4.28.7",
    "baseline-browser-mapping": "^2.11.0",
    "ws": "^8.21.3",
    "undici": "^7.29.1",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "workerd@1.20260310.1": true,
    "workerd@1.20260526.1": true,
    "workerd@1.20260910.1": true
  }
}
